# ===========================================
# Agentic Core - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# ----- Gemini API (Primary) -----
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash

# ----- Multi-LLM Routing (Optional) -----
# Primary provider: gemini
LLM_PROVIDER=gemini
# Fallback providers (comma-separated). Leave blank for Gemini-only mode.
LLM_FALLBACKS=

# ----- Anthropic (Optional) -----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ----- Qdrant Vector Database -----
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=educational_content_aurika

# ----- Google Sheets (Student Profiles) -----
GOOGLE_SHEETS_STUDENTS_ID=your_google_sheet_id
# Paste the full JSON from your service account key file (escape newlines with \\n)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"xxx","private_key":"-----BEGIN PRIVATE KEY-----\\nYOUR_KEY_HERE\\n-----END PRIVATE KEY-----\\n","client_email":"service@project.iam.gserviceaccount.com","client_id":"123"}
# Optional alternative: base64-encoded service account JSON
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_DRIVE_FOLDER_ID=
TODO_SHEET_ID=
TODO_SHEET_FILE_NAME=Aurika Agent Todo
TODO_WORKSHEET_NAME=tasks
TODO_AUDIT_WORKSHEET=audit_log

# ----- Cloudflare R2 Storage (Image Uploads) -----
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=testing
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ----- Logging (Optional) -----
TOKEN_LOG_PATH=logs/token_usage.csv
JSONL_LOG_PATH=logs/tutor_logs.jsonl
REQUEST_LOG_PATH=logs/requests.log
AGENT_STEPS_LOG_PATH=logs/agent_steps.jsonl
AGENT_RUNTIME_LOG_PATH=logs/agent_runtime.log

# ----- Tooling / Orchestration (Optional) -----
AGENTS_DIR=config/agents
WORKFLOW_SPECS_DIR=config/workflows
ALLOWED_HTTP_TOOL_DOMAINS=
AURIKA_ENGAGE_INTERNAL_API_KEY=
AURIKA_TASKS_API_URL=

# ----- Runtime / Security -----
# Set APP_ENV=production on Railway. In production, direct /api/* calls require AGENTIC_CORE_API_KEY.
APP_ENV=development

# When set, direct /api/* routes require this value via X-API-Key or Authorization: Bearer <key>.
AGENTIC_CORE_API_KEY=
AGENTIC_CORE_API_KEY_HEADER=X-API-Key

# Test-feature gates. Keep Hunter enabled only while it is an approved live test.
ENABLE_HUNTER_TEST_PIPELINE=true

# ----- Agent File Uploads (Optional) -----
AGENT_UPLOAD_MAX_FILE_MB=30
AGENT_UPLOAD_MAX_TOTAL_MB=60
AGENT_ATTACHMENT_MAX_EXTRACTED_CHARS=120000

# ----- Web Search / Research Tools (Optional) -----
TAVILY_API_KEY=

# ----- Hunter.io Test Pipeline (Optional) -----
HUNTER_API_KEY=
HUNTER_FALLBACK_ENABLED=true
HUNTER_CREDIT_PREFLIGHT_ENABLED=true
HUNTER_MIN_CREDITS_TO_RUN=5

# ----- Firebase / Firestore (Agent & Workflow Registry) -----
# Path to Firebase service account credentials JSON file
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
# Business ID used to scope all agent/workflow/tool records in Firestore
# Structure: businesses/{FIRESTORE_BUSINESS_ID}/agents | workflows | remote_tools
FIRESTORE_BUSINESS_ID=aurika-agentic-core

# ----- CORS (Optional) -----
# Comma-separated list of allowed origins. Example: http://localhost:3000,https://app.example.com
ALLOWED_ORIGINS=

# ----- Vento Plan 3 Pet Industry Lead Finder -----
# Set false to remove every /api/vento route while keeping Generic and Velit unchanged.
ENABLE_VENTO_PIPELINE=true
VENTO_LEADS_WORKSHEET_NAME=Vento Influencers
# Deterministic scoring is fastest; raise this only if you need Gemini reranking.
VENTO_GEMINI_MODEL=gemini-3.1-flash-lite
VENTO_GEMINI_MAX_CALLS_PER_RUN=0
# Fast-mode budgets keep Vento responsive even when Tavily/Apify/social pages are slow.
VENTO_DISCOVERY_CONCURRENCY=3
VENTO_ENRICHMENT_CONCURRENCY=8
VENTO_SCRAPE_CONCURRENCY=6
VENTO_SCRAPE_TIMEOUT_SECONDS=5
VENTO_SEARCH_TIMEOUT_SECONDS=12
VENTO_DISCOVERY_TIMEOUT_SECONDS=45
VENTO_ENRICHMENT_TIMEOUT_SECONDS=90
VENTO_APIFY_STAGE_TIMEOUT_SECONDS=70
VENTO_SCORING_TIMEOUT_SECONDS=25
VENTO_DISCOVERY_EXPANSION_ENABLED=true
VENTO_MAX_DISCOVERY_EXPANSION_QUERIES=6
VENTO_RESULTS_PER_DISCOVERY_QUERY=10
VENTO_MAX_ENRICHMENT_CANDIDATES=60
# Keep direct Instagram/TikTok page fetches off when Apify is enabled; Apify is more reliable and faster.
VENTO_SOCIAL_NAME_FETCH_ENABLED=false
VENTO_SOCIAL_NAME_TIMEOUT_SECONDS=4
# Optional Apify enrichment verifies Instagram/TikTok profile details after Tavily discovery.
VENTO_CREATOR_DATA_PROVIDER=apify
APIFY_API_TOKEN=
APIFY_INSTAGRAM_PROFILE_ACTOR=apify/instagram-scraper
APIFY_TIKTOK_PROFILE_ACTOR=clockworks/tiktok-scraper
VENTO_APIFY_ENRICHMENT_ENABLED=true
VENTO_APIFY_TIMEOUT_SECONDS=45
VENTO_APIFY_CANDIDATE_POOL=20
VENTO_APIFY_BATCH_SIZE=8
VENTO_APIFY_MAX_PROFILES_PER_RUN=15
VENTO_APIFY_CACHE_TTL_DAYS=30
VENTO_APIFY_CACHE_PATH=data/vento/apify_profile_cache.json
# Only return creator leads when at least one observed Instagram/TikTok count meets this threshold.
VENTO_MIN_SOCIAL_FOLLOWERS=50000
# Preferred creator band is 50K-500K. Above 500K can fill shortfalls unless disabled.
VENTO_MAX_SOCIAL_FOLLOWERS=500000
VENTO_ALLOW_ABOVE_MAX_SOCIAL_FOLLOWERS=true
# Keep false until Apify is configured/reliable; true means unknown follower counts are rejected.
VENTO_REQUIRE_SOCIAL_FOLLOWERS=false
VENTO_MAX_UPLOAD_MB=15
VENTO_MAX_IMPORT_ROWS=50000
